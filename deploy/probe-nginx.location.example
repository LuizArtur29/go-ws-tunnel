# Include inside an existing HTTPS server block. Replace BACKEND_IP and CA path.
# Go remains responsible for authentication and binary message limits.
location = /probe {
    proxy_pass https://BACKEND_IP:18443;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Host $host;
    proxy_ssl_server_name on;
    proxy_ssl_name go-ws-tunnel.internal;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 2;
    proxy_ssl_trusted_certificate /etc/nginx/conf.d/go-ws-tunnel-ca.pem;
    proxy_ssl_protocols TLSv1.2 TLSv1.3;
    proxy_connect_timeout 5s;
    proxy_read_timeout 130s;
    proxy_send_timeout 130s;
    proxy_buffering off;
    access_log off;
}
