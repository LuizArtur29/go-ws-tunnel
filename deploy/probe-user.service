[Unit]
Description=go-ws-tunnel WebSocket TLS diagnostic
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=%h/.config/go-ws-tunnel/probe.env
ExecStart=%h/.local/share/go-ws-tunnel/bin/probe server -unix ${PROBE_UNIX_SOCKET} -cert %h/.config/go-ws-tunnel/server.pem -key %h/.config/go-ws-tunnel/server.key -token-file %h/.config/go-ws-tunnel/access.token
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
